                },
                {
                  "type": "frame",
                  "id": "cOE6S",
                  "name": "Stack",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 60,
                  "padding": [
                    0,
                    0,
                    0,
                    463
                  ],
                  "children": [
                    {
                      "type": "frame",
                      "id": "l7Sush",
                      "name": "Stack",
                      "width": "fill_container",
                      "gap": 20,
                      "children": [
                        {
                          "type": "text",
                          "id": "TkJL6",
                          "name": "We specialize in rescuing and rebuilding troubled products — outdated tech, shaky security, bad vendor moves — and re-engineer it right. We ignite fresh software ideas and mitigate future risks, creating future-ready architecture powered by the latest tech.",
                          "fill": "#0f0f10ff",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "We specialize in rescuing and rebuilding troubled products — outdated tech, shaky security, bad vendor moves — and re-engineer it right.\nWe ignite fresh software ideas and mitigate future risks, creating future-ready architecture powered by the latest tech.",
                          "lineHeight": 1.5,
                          "fontFamily": "TT Interfaces",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "IxeXO",
                          "name": "Our AI Solution Accelerator™ slashes dev time and raises the quality bar at every stage. Built on our internal framework, it kills inefficiencies at the core: automating planning, development, testing and deployment with AI-driven integrated workflows. Think: prompt-level orchestration, pipeline-aware execution and context-rich feedback loops — all wired into your SDLC.",
                          "fill": "#0f0f10ff",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Our AI Solution Accelerator™ slashes dev time and raises the quality bar at every stage. Built on our internal framework, it kills inefficiencies at the core: automating planning, development, testing and deployment with AI-driven integrated workflows. Think: prompt-level orchestration, pipeline-aware execution and context-rich feedback loops — all wired into your SDLC.",
                          "lineHeight": 1.5,
                          "fontFamily": "TT Interfaces",
                          "fontSize": 16,
                          "fontWeight": "normal"
                        }
                      ]
